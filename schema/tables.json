{
  "schema_version": "0.1",
  "notes": "Machine-readable description of the content tables. schema/README.md is the human explanation; if the two disagree, fix them together. List-valued cells use semicolons: w001;w002.",
  "access_levels": ["open", "program", "restricted"],
  "forms_columns": ["form_1", "form_2", "form_3"],
  "tables": {
    "sources": {
      "file": "sources.csv",
