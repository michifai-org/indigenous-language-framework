    },
    "sounds": {
      "file": "sounds.csv",
      "columns": [
        {"name": "id", "required": true},
        {"name": "order", "required": true},
        {"name": "symbol_1", "required": true},
        {"name": "symbol_2"},
        {"name": "symbol_3"},
        {"name": "description"},
        {"name": "example_word_ids", "ref": "words", "list": true},
        {"name": "audio_id", "ref": "audio"},
        {"name": "notes"}
      ]
    }
  },
  "lesson": {
    "directory": "lessons",
    "required_keys": ["id", "order", "unit", "title", "level"],
    "list_keys": {
      "assumes_grammar": "grammar",
      "introduces_grammar": "grammar",
      "introduces_words": "words",
      "introduces_sounds": "sounds",
      "uses_sentences": "sentences",
      "uses_texts": "texts"
    }
  }
